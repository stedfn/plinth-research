.venv/

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.DS_Store

# setuptools leaves a stale copy of every source file here on an
# editable install; committing it would ship a second, silently
# divergent copy of the compiler.
build/

# Runs are local working state, not committed artifacts: archived blobs are
# third-party bytes, and `run.json` names one operator's campaign. Tests build
# runs in tmp_path from generated bytes, so nothing here is a coverage hole.
/runs/*
!/runs/.gitkeep

# Trust Centers built from those runs, and local scratch work.
/trust-centers/
.context/
